{
  "name": "gx-lite",
  "productName": "GX Lite",
  "version": "0.2.1",
  "description": "A small, fast, Chromium-based browser with a GX-style sidebar and workspaces.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "postinstall": "node scripts/copy-fonts.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.gxlite",
    "productName": "GX Lite",
    "files": [
      "src/**",
      "renderer/**",
      "opencode/**",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "12.0",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web link",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "artifactName": "gx-lite-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "TKX-k-4",
        "repo": "gx-lite",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "opencode/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "^5.1.0",
    "electron-updater": "^6.3.9",
    "node-pty": "^1.0.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "author": "GX Lite"
}